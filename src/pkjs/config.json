[
  { "type": "heading", "defaultValue": "Demi" },
  {
    "type": "section",
    "items": [
      { "type": "heading", "defaultValue": "Uiterlijk" },
      {
        "type": "select",
        "messageKey": "THEME",
        "label": "Achtergrond",
        "description": "Een licht accent wordt op een witte achtergrond automatisch donkerder, zodat je keuze leesbaar blijft.",
        "defaultValue": "0",
        "options": [
          { "label": "Donker (wit op zwart)", "value": "0" },
          { "label": "Licht (zwart op wit)", "value": "1" }
        ]
      },
      {
        "type": "color",
        "messageKey": "ACCENT_COLOR",
        "label": "Accentkleur",
        "defaultValue": "00ff7f",
        "sunlight": false,
        "layout": [
          ["00b894", "00ff7f", "00ffff"],
          ["5baee8", "0055ff", "c084fc"],
          ["ff55ff", "ff5aaa", "e05555"],
          ["e8a020", "ffdd00", "ffffff"]
        ]
      },
      {
        "type": "select",
        "messageKey": "CLOCK_SCHEME",
        "label": "Contrast uren/minuten",
        "description": "Hoe sterk de uren en de minuten afsteken tegen de achtergrond.",
        "defaultValue": "2",
        "options": [
          { "label": "Sterk / zwakst", "value": "0" },
          { "label": "Sterk / sterk", "value": "1" },
          { "label": "Sterk / zwak", "value": "2" },
          { "label": "Zwak / sterk", "value": "3" },
          { "label": "Accent / sterk", "value": "4" },
          { "label": "Sterk / accent", "value": "5" },
          { "label": "Accent / zwakst", "value": "6" },
          { "label": "Accent / zwak", "value": "7" }
        ]
      },
      {
        "type": "select",
        "messageKey": "LAYOUT_MODE",
        "label": "Indeling",
        "defaultValue": "0",
        "options": [
          { "label": "Verticaal (uren boven minuten)", "value": "0" },
          { "label": "Horizontaal (verticale bar)", "value": "1" },
          { "label": "Horizontaal (twee bars)", "value": "2" }
        ]
      },
      { "type": "toggle", "messageKey": "CLOCK_24H", "label": "24-uurs klok", "defaultValue": true },
      {
        "type": "select",
        "messageKey": "TAP_MODE",
        "label": "Tik op het horloge toont",
        "description": "Een tik op de pols vervangt de widgetrij vijf seconden lang.",
        "defaultValue": "0",
        "options": [
          { "label": "Niets", "value": "0" },
          { "label": "Seconden", "value": "1" },
          { "label": "Volledige datum", "value": "2" }
        ]
      }
    ]
  },
  {
    "type": "section",
