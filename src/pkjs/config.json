      { "type": "heading", "defaultValue": "Progressbar" },
      {
        "type": "select",
        "messageKey": "PROGRESS_TYPE",
        "label": "Toont",
        "defaultValue": "0",
        "options": [
          { "label": "Stappen", "value": "0" },
          { "label": "Batterij", "value": "1" },
          { "label": "Calorieën", "value": "2" },
          { "label": "Afstand", "value": "3" },
          { "label": "Aangepast 1 (JSON-url)", "value": "4" },
          { "label": "Aangepast 2 (JSON-url)", "value": "5" },
          { "label": "Daglicht", "value": "6" },
          { "label": "Dag verstreken", "value": "7" },
          { "label": "Week verstreken", "value": "8" },
          { "label": "Maand verstreken", "value": "9" },
          { "label": "Jaar verstreken", "value": "10" }
